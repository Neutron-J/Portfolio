---
import Footer from "@/components/Footer.astro";
import "@styles/reset.css";
import "@styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta
      name='description'
      content='Frontend Developer with a wide range of experience from vanilla JS to React and Vue.'
    />
    <meta name='viewport' content='width=device-width' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <link rel='preconnect' href='https://fonts.googleapis.com' />
    <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
    <link
      href='https://fonts.googleapis.com/css2?family=Outfit:wght@300..900&display=swap'
      rel='stylesheet'
    />
    <link
      href='https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&display=swap'
      rel='stylesheet'
    />
    <slot name='head' />
    <meta name='generator' content={Astro.generator} />
    <title>{title} | James Bates | Frontend Developer</title>
  </head>
  <body>
    <div class='wrapper'>
      <slot />
      <Footer />
    </div>
  </body>
</html>
<style is:global>
  .wrapper {
    height: 100%;
    min-height: 100%;
    display: grid;
    grid-template-rows: minmax(min-content, 0.66fr) 1fr min-content;
    max-width: 1600px;
    margin-left: auto;
    margin-right: auto;
  }
  :is(p) a {
    font-weight: var(--fontWeight-semibold);
    text-decoration: none;
    position: relative;

    &::after {
      content: "";
      position: absolute;
      z-index: -1;
      top: 66%;
      left: -0.1em;
      right: -0.1em;
      bottom: 0;
      transition: top 200ms cubic-bezier(0, 0.8, 0.13, 1);
      background-color: var(--color-secondary-lighter);
    }
    &:hover {
      color: var(--color-primary);
      &::after {
        top: 0%;
      }
    }
  }
</style>
